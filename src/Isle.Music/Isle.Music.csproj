<Project Sdk="Microsoft.NET.Sdk">

  <!-- Music pack: media session, music pill and accent. Isle.exe loads Isle.Music.dll from its own folder when present (Core/Packs.cs). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>14</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Isle</RootNamespace>
    <AssemblyName>Isle.Music</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <IslePack>true</IslePack>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Isle.Tests" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Isle\Isle.csproj" Private="false" />
  </ItemGroup>

</Project>
