<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>14</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Isle</RootNamespace>
    <AssemblyName>Isle</AssemblyName>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Isle.Tests" />
    <Using Include="System.IO" />
  </ItemGroup>

  <!-- Agents (M13): the pipe protocol is shared with the hook helper; the helper is built first and copied next to Isle.exe. -->
  <ItemGroup>
    <Compile Include="..\Isle.Hook\HookProtocol.cs" Link="Modules\Agents\HookProtocol.cs" />
    <ProjectReference Include="..\Isle.Hook\Isle.Hook.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <Target Name="CopyHookHelper" AfterTargets="Build">
    <PropertyGroup>
      <HookOut>..\Isle.Hook\bin\$(Configuration)\net10.0\</HookOut>
    </PropertyGroup>
    <ItemGroup>
      <HookFiles Include="$(HookOut)Isle.Hook.exe;$(HookOut)Isle.Hook.dll;$(HookOut)Isle.Hook.runtimeconfig.json;$(HookOut)Isle.Hook.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(HookFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(HookOut)Isle.Hook.exe')" />
  </Target>

</Project>
