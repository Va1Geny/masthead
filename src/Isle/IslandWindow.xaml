<Window x:Class="Isle.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Isle.Views"
        Title="Isle"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <!-- One fixed-size transparent window. Only the island shape (Body's clip) has pixels, so everything else
         is click-through. The shape is animated by changing the clip geometry, never the window size. -->
    <Grid x:Name="Root" TextElement.Foreground="{DynamicResource FgBrush}" TextElement.FontFamily="{StaticResource UiFont}"
          TextElement.FontSize="12.5">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Canvas x:Name="Stage" Width="640" Height="300" HorizontalAlignment="Center" VerticalAlignment="Top">

            <!-- soft shadow: three stacked translucent shapes following the island (cheap, no blur effect) -->
            <Path x:Name="Shadow3" Fill="#08000000" IsHitTestVisible="False" />
            <Path x:Name="Shadow2" Fill="#10000000" IsHitTestVisible="False" />
            <Path x:Name="Shadow1" Fill="#1A000000" IsHitTestVisible="False" />

            <Grid x:Name="Body" Width="640" Height="300">
                <Rectangle Fill="{DynamicResource BgBrush}" />

                <!-- collapsed content -->
                <Grid x:Name="PillLayer" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" Width="120" Height="32"
                      Background="Transparent" Cursor="Hand">
                    <DockPanel LastChildFill="True">
                        <ContentPresenter x:Name="PillSecondary" DockPanel.Dock="Right" />
                        <ContentPresenter x:Name="PillPrimary" />
                    </DockPanel>
                </Grid>

                <!-- expanded content -->
                <Grid x:Name="Panel" Width="520" Height="220" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
                      Visibility="Collapsed" RenderTransformOrigin="0.5,0" Background="Transparent">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="PanelScale" />
                    </Grid.RenderTransform>
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <v:TabBar x:Name="Tabs" />
                        <Grid x:Name="TabContent" Grid.Row="1" Margin="0,8,0,0" ClipToBounds="True" />
                        <TextBlock x:Name="EmptyText" Grid.Row="1" Style="{StaticResource TextDim}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed" />
                    </Grid>

                    <!-- overlay list for tabs that do not fit ("more") -->
                    <Border x:Name="MoreOverlay" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,12,0"
                            Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="4" MinWidth="150" MaxHeight="164"
                            KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
                        <ScrollViewer>
                            <StackPanel x:Name="MoreList" />
                        </ScrollViewer>
                    </Border>

                    <!-- toast -->
                    <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                            Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                            CornerRadius="14" Padding="12,4,4,4" MaxWidth="460">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ToastText" Style="{StaticResource Text}" MaxWidth="340" Margin="0,0,8,0" />
                            <Button x:Name="ToastAction" Style="{StaticResource GhostButton}" Foreground="{DynamicResource AccentTextBrush}" MinHeight="22" Padding="8,2" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Path x:Name="Outline" Stroke="{DynamicResource StrokeBrush}" StrokeThickness="1" IsHitTestVisible="False" />
        </Canvas>
    </Grid>
</Window>
